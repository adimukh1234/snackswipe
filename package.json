{
  "name": "crave",
  "version": "1.0.0",
  "private": true,
  "description": "Tinder for food ordering - swipe-based food discovery platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "cd apps/web && npm run lint",
    "lint:api": "cd apps/api && npm run lint",
    "test:e2e": "cd apps/web && npm run test:e2e"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.0.0",
    "shadcn": "^4.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
